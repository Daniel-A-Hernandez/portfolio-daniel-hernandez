import Button from "../components/ui/button.astro"
import Abilities from "../components/ui/Abillities.astro"
import Contact from "../components/ui/Contact.astro"

//#########################################

---

<Layout>
                
     
        <ProfileCard/>
        <Button
            document="https://wa.me/50375138755?text=Hola%20Daniel%20%0ATe%20escribo%20porque%20vi%20tu%20portafolio%20y%20me%20gustaría%20conversar%20contigo.%0AQuedo%20atento,%20gracias."
            
