---
import {Image} from "astro:assets"

import profileImg from "@/assets/Daniel.png"

const stats = [
  {
    value: "03",
    label: "Proyectos destacados",
  },
  {
    value: "01",
    label: "Cliente real",
  },
  { 
    value: new Date().getFullYear(),
    label: "Portfolio actual",
  },
];

const tags = [
  "Frontend",
  "TypeScript",
  "Astro",
  "React",
  "UI Development",
];


---

<section class="mt-10 mb-24">
  <div
    class="
      grid
      grid-cols-1
      md:grid-cols-[1.15fr_.85fr]
      items-center
      gap-12
    "
  >
    <!-- Información -->
    <article>

      <!-- Estado / ubicación -->
      <div
        class="
          flex
          items-center
          justify-center
          md:justify-start
          gap-2
          mb-5
        "
      >
        <span
          class="
            w-2
            h-2
            rounded-full
            bg-emerald-400
            shadow-[0_0_10px_rgba(52,211,153,.6)]
          "
        ></span>

        <span
          class="
            font-mono
            text-xs
            uppercase
            tracking-[0.22em]
            text-[#94a3b8]
          "
        >
          Software Developer · El Salvador 🇸🇻
        </span>
      </div>

      <!-- Título -->
      <h1
        class="
          text-3xl
          md:text-4xl
          lg:text-5xl
          font-bold
          leading-tight
          tracking-tight
          text-[#f8fafc]

          text-center
          md:text-left
        "
      >
        Desarrollo experiencias digitales

        <span
          class="
            block
            mt-1
            bg-gradient-to-r
            from-[#38bdf8]
            to-[#8b5cf6]
            bg-clip-text
            text-transparent
          "
        >
          claras, modernas y funcionales.
        </span>
      </h1>

      <!-- Descripción -->
      <p
        class="
          mt-6
          max-w-2xl
          mx-auto
          md:mx-0

          text-[#94a3b8]
          text-base
          md:text-lg
          leading-8

          text-center
          md:text-left
        "
      >
      Desarrollador Software de El Salvador 🇸🇻, especializado en frontend y en la creación de interfaces modernas, claras y funcionales. Combino desarrollo, diseño y atención al detalle para construir productos digitales intuitivos y bien estructurados. 
     
      </p>

      <!-- Tags -->
      <div
        class="
          flex
          flex-wrap
          justify-center
          md:justify-start
          gap-2
          mt-7
        "
      >
        {
          tags.map((tag) => (
            <span
              class="
                px-3
                py-1.5

                rounded-full
                border
                border-white/10

                bg-white/[0.025]

                text-[#94a3b8]
                text-xs
                font-mono

                transition-all
                duration-300

                hover:text-[#38bdf8]
                hover:border-[#38bdf8]/30
                hover:bg-[#38bdf8]/5
              "
            >
              {tag}
            </span>
          ))
        }
      </div>

      <!-- Stats -->
      <div
        class="
          grid
          grid-cols-3
          gap-3

          mt-9
          pt-7

          border-t
          border-white/10
        "
      >
        {
          stats.map((stat) => (
            <div class="text-center md:text-left">
              <p
                class="
                  text-[#f8fafc]
                  text-xl
                  font-semibold
                  font-mono
                "
              >
                {stat.value}
              </p>

              <p
                class="
                  text-[#64748b]
                  text-xs
                  mt-1
                  leading-5
                "
              >
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>

    </article>


    <!-- FOTO -->
    <div
      class="
        relative
        w-full
        max-w-[330px]
        mx-auto
      "
    >

      <!-- Marco exterior -->
      <div
        class="
          absolute
          -inset-3

          rounded-[28px]
          border
          border-[#38bdf8]/10

          pointer-events-none
        "
      ></div>

      <!-- Decoración superior -->
      <div
        class="
          absolute
          -top-5
          -right-5

          w-24
          h-24

          rounded-full
          border
          border-[#38bdf8]/15

          pointer-events-none
        "
      ></div>

      <!-- Decoración inferior -->
      <div
        class="
          absolute
          -bottom-5
          -left-5

          w-28
          h-28

          rounded-full
          border
          border-[#8b5cf6]/15

          pointer-events-none
        "
      ></div>


      <!-- Card principal -->
      <div
        class="
          relative

          p-2

          bg-[#0c111d]

          rounded-[24px]

          border
          border-white/10

          overflow-hidden
        "
      >

        <!-- Imagen -->
        <div
          class="
            relative
            aspect-[4/5]
            overflow-hidden
            rounded-[18px]

            bg-gradient-to-br
            from-[#1e293b]
            to-[#020617]
          "
        >

          <!--
            REEMPLAZA ESTE DIV POR TU FOTO
            CUANDO LA TENGAS.
          -->



          <img
            src={profileImg.src}
            alt="Daniel Hernández"
            class="
              w-full
              h-full
              object-cover
              object-center
            "
          />


          <!-- Overlay -->
          <div
            class="
              absolute
              inset-0

              bg-gradient-to-b
              from-transparent
              via-transparent
              to-black/60

              pointer-events-none
            "
          ></div>


          <!-- Nombre sobre la foto -->
          <div
            class="
              absolute
              left-4
              right-4
              bottom-4
            "
          >

            <div
              class="
                p-4

                rounded-xl

                border
                border-white/10

                bg-black/30
                backdrop-blur-md
              "
            >
              <p
                class="
                  text-white
                  font-semibold
                  text-lg
                "
              >
                Daniel Hernández
              </p>

              <p
                class="
                  mt-1
                  text-xs
                  font-mono
                  text-white/50
                "
              >
                Software Developer
              </p>
            </div>

          </div>

        </div>
      </div>


      <!-- Badge flotante -->
      <div
        class="
          absolute
          top-12
          -right-5

          hidden
          sm:block

          px-3
          py-2

          rounded-xl

          border
          border-white/10

          bg-[#0c111d]

          text-[#94a3b8]
          text-xs
          font-mono

          shadow-xl
        "
      >
        &lt;/developer&gt;
      </div>

    </div>

  </div>
</section>