            document = "/curriculum-daniel-hernandez.pdf"
            btn_name="DESCARGAR CV"
        />


        <div class="mt-12 grid gap-6 place-items-center grid-cols-[repeat(auto-fit,minmax(300px,1fr))] p-2">

            <Card />

        </div>

        <Abilities/>  
        <h2 class=" text-white max-w-[1100px] h-auto flex justify-center  mt-10 text-3xl font-bold ">TECNOLOGÍAS</h2>
    
        <Carusel/>
        <Contact/>
    












