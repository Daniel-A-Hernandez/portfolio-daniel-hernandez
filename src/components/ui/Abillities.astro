---
import {skills} from "@/data/habilidades"

---



<section class="mt-20">
  <div class="text-center mb-10">
    <p
      class="text-xs uppercase tracking-[0.25em] text-[#94a3b8]"
    >
      Lo que puedo construir
    </p>

    <h2 class="text-white max-w-[1100px] h-auto flex justify-center  mt-10 text-3xl font-bold ">
      HABILIDADES
    </h2>

    <p class="text-[#94a3b8] mt-3">
      Capacidades que aplico para convertir ideas
      en productos digitales funcionales.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {
      skills.map((skill) => (
        <article
          class="
            relative
            bg-[#0c111d]
            border border-white/10
            rounded-2xl
            p-6
            transition-all duration-300
            hover:-translate-y-1
            hover:border-[#38bdf8]/30
          "
        >
          <span
            class="absolute top-5 right-5
                   text-xs font-mono text-[#64748b]"
          >
            {skill.number}
          </span>

          <h3 class="text-white text-xl font-semibold">
            {skill.title}
          </h3>

          <p class="text-[#94a3b8] text-sm leading-relaxed mt-3">
            {skill.description}
          </p>

          <div class="h-px bg-white/10 my-5"></div>

          <ul class="space-y-2">
            {skill.abilities.map((ability) => (
              <li class="text-sm text-[#cbd5e1] flex gap-2">
                <span class="text-[#38bdf8]">↳</span>
                {ability}
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2 mt-6">
            {skill.technologies.map((tech) => (
              <span
                class="
                  text-xs font-mono
                  px-3 py-1
                  rounded-full
                  border border-white/10
                  text-[#94a3b8]
                "
              >
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>